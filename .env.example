# Local Docker ports. Set APP_ORIGIN to the user-facing origin in production.
APP_ORIGIN=http://localhost:3100
FRONTEND_PORT=3100
AGENTCITY_DOCKER_SUBNET=10.196.213.0/24
DEMO_ENABLED=true
COOKIE_SECURE=false
ENABLE_REGISTRATION=true
# Configure SMTP_HOST before requiring email verification.
REQUIRE_EMAIL_VERIFICATION=false
DB_PASSWORD=agentcity-local
# Local bare-metal development uses SQLite unless DATABASE_URL is set.
# DATABASE_URL=postgresql+psycopg://agentcity:password@localhost:5432/agentcity
# Only relevant to SQLite development.
SQLITE_AUTO_SCHEMA=true

# Authentication mail
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=agentcity@localhost
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Model credentials are read exclusively by the backend.
# Generate with python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
ALLOW_CLOUD_MODELS=false
MODEL_ALLOWED_ORIGINS=
MODEL_LOCAL_ORIGINS=http://host.docker.internal:1234
DEMO_LOCAL_PROVIDER=lm-studio,lm-studio-embedding

OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AZURE_OPENAI_MODEL=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_AI_MODEL=
AZURE_AI_BASE_URL=
AZURE_AI_API_KEY=
GEMINI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
VLLM_MODEL=
VLLM_BASE_URL=
LLAMA_CPP_MODEL=
LLAMA_CPP_BASE_URL=
LM_STUDIO_MODEL=prism-ml/bonsai-27b
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_CAPABILITIES=structured,streaming,vision,tools
# Routing metadata can also be set for other providers using their configuration prefix.
LM_STUDIO_LANGUAGES=
LM_STUDIO_REASONING_TIER=standard
LM_STUDIO_COST_PER_MILLION=
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
HUGGING_FACE_MODEL=
HUGGING_FACE_BASE_URL=
HUGGING_FACE_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

LOG_LEVEL=INFO
WORKER_CONCURRENCY=4
RUN_RETENTION_DAYS=0
TELEMETRY_ORIGINS=
NOTIFICATION_ORIGINS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
PUBLIC_PLANS=[]
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318

